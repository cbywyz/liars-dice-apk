<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- app_name 改由 build.gradle 的 productFlavor resValue 提供：
         完整版「吹牛骰子」，纯净版「吹牛骰子纯净」。
         这里不要再写同名 string，否则会和 flavor 冲突。 -->

    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F4F0E9</item>
        <item name="android:statusBarColor">#F4F0E9</item>
        <item name="android:navigationBarColor">#F4F0E9</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
